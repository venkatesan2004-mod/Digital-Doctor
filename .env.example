# ==============================================================================
# DIGITAL DOCTOR ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting containers:
#   copy .env.example .env (Windows) OR cp .env.example .env (Linux/macOS)
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Digital Doctor"

# Network & Host Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PORT=3306
CHROMA_PORT=8001

# Authoritative Relational Database (MySQL 8.0)
MYSQL_HOST=mysql
MYSQL_DATABASE=digital_doctor
MYSQL_USER=digital_doctor_app
MYSQL_PASSWORD=replace_with_local_development_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
# Standard SQLAlchemy Database Connection URI:
DATABASE_URL=mysql+pymysql://digital_doctor_app:replace_with_local_development_password@mysql:3306/digital_doctor?charset=utf8mb4

# Vector Database (ChromaDB)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_URL=http://chromadb:8000
CHROMA_COLLECTION_PREFIX=dd_

# AI & Retrieval Engine Configuration
# Available AI Providers: mock (default for zero-cost dev/demo), openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=30

# Embedding Provider: mock, openai
EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Hospital Information Management System (HIMS) Integration
# Available Providers: mock, webhook
HIMS_PROVIDER=mock
HIMS_API_URL=http://mock-hims.internal/api/v1
HIMS_API_KEY=synthetic_dev_hims_key

# Security & Cryptography
# Generate a secure 64+ char secret for JWT in production
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
KIOSK_SESSION_TIMEOUT_MINUTES=15
KIOSK_RATE_LIMIT_MAX_ATTEMPTS=5
KIOSK_RATE_LIMIT_WINDOW_SECONDS=300

# File Upload Policies
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg

# Seed & Demo Mode Settings
DEMO_MODE=true
ENABLE_SYNTHETIC_SEED_DATA=true
DEMO_VERIFICATION_DEFAULT_YEAR=1985
